# Savdoyim — sozlamalar namunasi. Nusxa oling: .env.example -> .env
# va o'z qiymatlaringiz bilan to'ldiring.

# ── Django ──
DJANGO_SECRET_KEY=bu-yerga-yangi-maxfiy-kalit
# Lokal: True.  SERVERDA (production): False
DJANGO_DEBUG=True
# Productionda majburiy: sayt domeni yoki IP (vergul bilan)
# Masalan: DJANGO_ALLOWED_HOSTS=savdoyim.uz,www.savdoyim.uz,203.0.113.10
DJANGO_ALLOWED_HOSTS=

# ── Production xavfsizligi (faqat DJANGO_DEBUG=False bo'lganda ta'sir qiladi) ──
# Server HTTPS (SSL) bo'lsa True qoldiring. HALI HTTPS bo'lmasa -> False (aks holda sayt ochilmaydi)
SECURE_SSL_REDIRECT=True
# Cookie'lar faqat HTTPS orqali (HTTPS bo'lsa True)
SECURE_COOKIES=True
# HSTS — faqat sayt TO'LIQ HTTPS bo'lganda True qiling
ENABLE_HSTS=False
# CORS: productionda odatda False
CORS_ALLOW_ALL=False

# ── Email (Brevo SMTP) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_LOGIN=
SMTP_PAROL=
SMTP_FROM=

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=

# ── Telefonda HTTPS test uchun (lokal) ──
CSRF_TRUSTED_ORIGINS=

# ── Ma'lumotlar bazasi ──
# Ko'p foydalanuvchi uchun PostgreSQL (tavsiya). Lokal test uchun: sqlite
DB_ENGINE=postgres
DB_NAME=savdoyim1
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
